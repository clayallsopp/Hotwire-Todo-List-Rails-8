<% form_data = if todo.new_record?
     { controller: "reset-form", action: "turbo:submit-end->reset-form#reset" }
   else
     { turbo: false }
   end %>

<%= form_with(model: todo, id: "#{dom_id(todo)}_form", class: "todo-form", data: form_data) do |form| %>
  <% if todo.errors.any? %>
    <div class="error-explanation" role="alert">
      <h2><%= pluralize(todo.errors.count, "error") %> prohibited this todo from being saved:</h2>
      <ul>
        <% todo.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="todo-form-row">
    <%= form.label :title, "Item" %>
    <%= form.text_field :title, placeholder: "What needs doing?", autocomplete: "off" %>
    <% if todo.new_record? %>
      <%= form.hidden_field :status, value: "incomplete" %>
      <%= form.submit "Add" %>
    <% else %>
      <%= form.label :status, "Status" %>
      <%= form.select :status, [ [ "Incomplete", "incomplete" ], [ "Complete", "complete" ] ] %>
      <%= form.submit "Save" %>
    <% end %>
  </div>
<% end %>
