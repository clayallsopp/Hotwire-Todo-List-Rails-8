<li id="<%= dom_id(todo) %>" class="todo-item">
  <span class="todo-status"><%= todo.status == "complete" ? "[x]" : "[ ]" %></span>

  <span class="todo-title<%= " completed" if todo.status == "complete" %>">
    <%= todo.title %>
  </span>

  <div class="todo-actions">
    <% if todo.status == "complete" %>
      <%= button_to "Incomplete", todo_path(todo, todo: { status: "incomplete" }), method: :patch, class: "inline-button" %>
    <% else %>
      <%= button_to "Complete", todo_path(todo, todo: { status: "complete" }), method: :patch, class: "inline-button" %>
    <% end %>

    <%= link_to "Edit", edit_todo_path(todo), class: "edit-link" %>
    <%= button_to "Delete", todo_path(todo), method: :delete, class: "delete-button", data: { turbo_confirm: "Are you sure you want to delete this todo?" } %>
  </div>
</li>
